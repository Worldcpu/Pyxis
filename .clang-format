BasedOnStyle: Google

# C++20 standard
Standard: c++20

# Indentation
IndentWidth: 2
TabWidth: 2
UseTab: Never

# Column limit as per Google style
ColumnLimit: 80

# Pointer/reference alignment
DerivePointerAlignment: false
PointerAlignment: Left

# Include sorting
SortIncludes: true
IncludeBlocks: Regroup

# Braces
BreakBeforeBraces: Attach
